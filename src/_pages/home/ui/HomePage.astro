---
import type {PageContent} from '@gravity-ui/page-constructor';

import {getNextEvent} from '@/shared/api';
import {faqSchema, organizationSchema, websiteSchema} from '@/shared/lib';
import {PageBlocks, SiteLayout} from '@/shared/ui';

import content from '../../../../content/home.json';

// Запрос уходит на этапе сборки; при недоступности API берётся снапшот
const nextEvent = await getNextEvent();

// Вопросы для разметки берём из того же файла, что и блок на странице
const faqBlock = content.blocks.find((block) => block.type === 'faq');
const faqItems = (faqBlock?.items ?? []) as {question: string; answer: string}[];

const schemas = [organizationSchema(), websiteSchema(), faqSchema(faqItems)];
---

<SiteLayout schemas={schemas}>
  <PageBlocks content={content as PageContent} data={{nextEvent}} />
</SiteLayout>
