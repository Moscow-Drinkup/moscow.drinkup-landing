---
import {galleryImages} from '../model/content';
import {withBase} from '@/shared/lib';
---

<section class="gallery" aria-labelledby="gallery-title">
  <h2 class="gallery__title" id="gallery-title">Как это выглядит</h2>

  <ul class="gallery__grid">
    {
      galleryImages.map((image, index) => (
        <li>
          <button
            type="button"
            class="gallery__item"
            data-lightbox-open={index}
            aria-label={`Открыть фото: ${image.alt}`}
          >
            <img src={image.src} alt={image.alt} loading="lazy" />
          </button>
        </li>
      ))
    }
  </ul>

  <a class="gallery__more" href={withBase('/events')}>
    Фотоотчёты с дринкапов — на страницах мероприятий →
  </a>
</section>

<dialog class="lightbox" data-lightbox aria-label="Просмотр фотографии">
  <img class="lightbox__image" data-lightbox-image src="" alt="" />
  <div class="lightbox__controls">
    <button type="button" class="lightbox__button" data-lightbox-prev aria-label="Предыдущее фото">
      ←
    </button>
    <span class="lightbox__counter" data-lightbox-counter></span>
    <button type="button" class="lightbox__button" data-lightbox-next aria-label="Следующее фото">
      →
    </button>
    <button type="button" class="lightbox__button" data-lightbox-close aria-label="Закрыть">
      ✕
    </button>
  </div>
</dialog>

<script>
  // Лайтбокс на нативном dialog: фокус-ловушка и Escape достаются бесплатно.
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const counter = document.querySelector<HTMLElement>('[data-lightbox-counter]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));

  if (dialog && image && counter && triggers.length > 0) {
    const photos = triggers.map((trigger) => {
      const img = trigger.querySelector('img');
      return {src: img?.src ?? '', alt: img?.alt ?? ''};
    });

    let current = 0;

    const show = (index: number) => {
      current = (index + photos.length) % photos.length;
      image.src = photos[current].src;
      image.alt = photos[current].alt;
      counter.textContent = `${current + 1} / ${photos.length}`;
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        show(index);
        dialog.showModal();
      });
    });

    document
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    document
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));
    document
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());

    // Клик по подложке за пределами картинки закрывает просмотр
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        show(current + 1);
      }
    });
  }
</script>

<style>
  .gallery {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 72px;
  }

  .gallery__title {
    margin: 0 0 32px;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    color: var(--g-color-text-primary);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
  }

  .gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .gallery__item:hover img {
    transform: scale(1.04);
  }

  .gallery__more {
    display: inline-block;
    margin-top: 24px;
    color: var(--g-color-text-brand);
    text-decoration: none;
  }

  .lightbox {
    max-width: min(1100px, 92vw);
    max-height: 92vh;
    padding: 0;
    background: #120e0a;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 16px;
    color: var(--g-color-text-primary);
  }

  .lightbox::backdrop {
    background: rgb(11 9 7 / 88%);
    backdrop-filter: blur(8px);
  }

  .lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    margin: 0 auto;
  }

  .lightbox__controls {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .lightbox__button {
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 10px;
    color: var(--g-color-text-primary);
    font-size: 18px;
    cursor: pointer;
  }

  .lightbox__button:hover {
    border-color: var(--g-color-line-brand);
    color: var(--g-color-text-brand);
  }

  .lightbox__counter {
    min-width: 72px;
    color: var(--g-color-text-secondary);
    font-family: var(--g-font-family-monospace);
    text-align: center;
  }
</style>
