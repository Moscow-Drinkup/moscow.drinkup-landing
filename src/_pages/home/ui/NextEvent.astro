---
import {EXTERNAL_LINK_ATTRS, LINKS} from '@/shared/config';
import {formatEventDate, withBase} from '@/shared/lib';
import type {DrinkupEvent} from '@/shared/api';

interface Props {
  event: DrinkupEvent | null;
}

const {event} = Astro.props;
const date = event ? formatEventDate(event.start) : '';
---

{
  event && (
    <section class="next-event" aria-labelledby="next-event-title">
      <div class="next-event__card">
        {event.cover && (
          <a
            class="next-event__media"
            href={event.url}
            {...EXTERNAL_LINK_ATTRS}
            aria-label={`${event.name} — страница регистрации`}
          >
            <img src={event.cover} alt="" loading="lazy" />
          </a>
        )}

        <div class="next-event__body">
          <p class="next-event__label">Ближайший дринкап{event.num ? ` ${event.num}` : ''}</p>
          <h2 class="next-event__name" id="next-event-title">
            {event.name}
          </h2>
          {date && <p class="next-event__date">{date}</p>}

          <div class="next-event__actions">
            <a class="next-event__cta" href={event.url} {...EXTERNAL_LINK_ATTRS}>
              Зарегистрироваться
            </a>
            <a class="next-event__all" href={withBase('/events')}>
              Все мероприятия →
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  !event && (
    <section class="next-event">
      <div class="next-event__card next-event__card--empty">
        <p class="next-event__label">Дата следующего дринкапа</p>
        <p class="next-event__date">
          Пока не объявлена — анонс появится в сообществе на Networkly.
        </p>
        <a class="next-event__cta" href={LINKS.networkly} {...EXTERNAL_LINK_ATTRS}>
          Следить за анонсами
        </a>
      </div>
    </section>
  )
}

<style>
  .next-event {
    padding: 0 24px;
  }

  .next-event__card {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    max-width: 1000px;
    margin: -32px auto 0;
    padding: 24px;
    background: #120e0a;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 20px;
  }

  .next-event__card--empty {
    flex-direction: column;
    align-items: flex-start;
  }

  .next-event__media {
    flex: 0 0 320px;
    max-width: 100%;
    border-radius: 14px;
    overflow: hidden;
  }

  .next-event__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .next-event__body {
    display: flex;
    flex: 1 1 320px;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .next-event__label {
    margin: 0;
    color: var(--g-color-text-brand);
    font-family: var(--g-font-family-monospace);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .next-event__name {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    color: var(--g-color-text-primary);
  }

  .next-event__date {
    margin: 0;
    color: var(--g-color-text-secondary);
  }

  .next-event__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 8px;
  }

  .next-event__cta {
    padding: 12px 24px;
    background: var(--g-color-base-brand);
    border-radius: 12px;
    color: var(--g-color-text-brand-contrast);
    font-weight: 600;
    text-decoration: none;
  }

  .next-event__cta:hover {
    background: var(--g-color-base-brand-hover);
  }

  .next-event__all {
    color: var(--g-color-text-secondary);
    text-decoration: none;
  }

  .next-event__all:hover {
    color: var(--g-color-text-brand);
  }
</style>
