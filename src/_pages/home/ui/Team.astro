---
import {teamMembers} from '../model/content';
import {EXTERNAL_LINK_ATTRS} from '@/shared/config';
---

<section class="team" id="team" aria-labelledby="team-title">
  <h2 class="team__title" id="team-title">Организаторы</h2>

  <ul class="team__list">
    {
      teamMembers.map((member) => (
        <li class="team__card">
          <img
            class="team__photo"
            src={member.photo}
            alt=""
            width="96"
            height="96"
            loading="lazy"
          />
          <p class="team__name">{member.name}</p>
          <p class="team__role">{member.role}</p>
          <a
            class="team__telegram"
            href={`https://t.me/${member.telegram.replace('@', '')}`}
            {...EXTERNAL_LINK_ATTRS}
          >
            {member.telegram}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .team {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 24px;
  }

  .team__title {
    margin: 0 0 32px;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    color: var(--g-color-text-primary);
  }

  .team__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: #120e0a;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 18px;
  }

  .team__photo {
    border-radius: 50%;
    object-fit: cover;
  }

  .team__name {
    margin: 8px 0 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--g-color-text-primary);
  }

  .team__role {
    flex: 1;
    margin: 0;
    color: var(--g-color-text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  .team__telegram {
    color: var(--g-color-text-brand);
    font-family: var(--g-font-family-monospace);
    font-size: 14px;
    text-decoration: none;
  }
</style>
