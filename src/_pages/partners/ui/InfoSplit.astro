---
export interface InfoLink {
  href: string;
  label: string;
}

export interface InfoPoint {
  title: string;
  text: string;
}

interface Props {
  id: string;
  title: string;
  text: string;
  points?: InfoPoint[];
  links?: InfoLink[];
  aside: {
    title: string;
    text: string;
    links?: InfoLink[];
  };
}

const {id, title, text, points = [], links = [], aside} = Astro.props;
---

<section class="split" aria-labelledby={id}>
  <div class="split__main">
    <h2 class="split__title" id={id}>{title}</h2>
    <p class="split__text">{text}</p>

    {
      points.length > 0 && (
        <ul class="split__points">
          {points.map((point) => (
            <li class="split__point">
              <p class="split__point-title">{point.title}</p>
              <p class="split__point-text">{point.text}</p>
            </li>
          ))}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <p class="split__links">
          {links.map((link) => (
            <a class="split__link" href={link.href}>
              {link.label}
            </a>
          ))}
        </p>
      )
    }
  </div>

  <aside class="split__aside">
    <h3 class="split__aside-title">{aside.title}</h3>
    <p class="split__aside-text">{aside.text}</p>
    {
      aside.links?.map((link) => (
        <a class="split__link" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </aside>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto 32px;
    padding: 40px 32px;
    background: #1a1206;
    border-radius: 24px;
  }

  .split__title {
    margin: 0 0 16px;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    color: var(--g-color-text-primary);
  }

  .split__text {
    margin: 0;
    color: var(--g-color-text-secondary);
    line-height: 1.6;
  }

  .split__points {
    display: grid;
    gap: 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .split__point-title {
    margin: 0 0 4px;
    color: var(--g-color-text-brand);
    font-weight: 600;
  }

  .split__point-text {
    margin: 0;
    color: var(--g-color-text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  .split__links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 28px 0 0;
  }

  .split__link {
    color: var(--g-color-text-brand);
    text-decoration: none;
  }

  .split__link:hover {
    text-decoration: underline;
  }

  .split__aside {
    align-self: start;
    padding: 24px;
    background: #120e0a;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 20px;
  }

  .split__aside-title {
    margin: 0 0 12px;
    font-size: 19px;
    font-weight: 600;
    color: var(--g-color-text-primary);
  }

  .split__aside-text {
    margin: 0 0 16px;
    color: var(--g-color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (width <= 900px) {
    .split {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
  }
</style>
