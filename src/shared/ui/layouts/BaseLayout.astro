---
import {SITE} from '@/shared/config';
import {isPreviewBuild, withBase} from '@/shared/lib';
// Токены дизайн-системы: определяют --g-color-text-*, --g-color-base-* и прочее.
// Наша тема переопределяет часть из них и потому подключается следом.
import '@gravity-ui/uikit/styles/styles.css';
import '@/shared/styles';

interface Props {
  /** Заголовок страницы. Полностью заменяет title, шаблон не применяется. */
  title?: string;
  description?: string;
  /** Абсолютный или относительный путь к картинке для Open Graph. */
  ogImage?: string;
  /** Тип страницы для Open Graph: website для разделов, article для событий. */
  ogType?: 'website' | 'article';
  /** Блоки разметки schema.org, попадают в head отдельными script-тегами. */
  schemas?: unknown[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  ogType = 'website',
  schemas = [],
} = Astro.props;

// Astro.site задан в astro.config.mjs, поэтому URL всегда абсолютные
const canonical = new URL(Astro.url.pathname, Astro.site);
// Картинка может быть как локальной (тогда нужен base), так и внешней —
// например обложкой события с CDN Networkly
const ogImageUrl = new URL(/^https?:\/\//.test(ogImage) ? ogImage : withBase(ogImage), Astro.site);

// Превью пул-реквестов лежат на том же домене — закрываем их от индексации,
// чтобы не плодить дубли боевых страниц в выдаче
const robots = isPreviewBuild() ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="robots" content={robots} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href={withBase(SITE.logo)} />
    <link rel="apple-touch-icon" href={withBase(SITE.logo)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href={withBase('/fonts/JetBrainsSans-Regular.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/JetBrainsSans-SemiBold.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      // Разметку не отдаём в превью: там страницы закрыты от индексации
      !isPreviewBuild() &&
        schemas.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
    }

    <slot name="head" />
  </head>
  <body class="g-root g-root_theme_dark">
    <slot />
  </body>
</html>
