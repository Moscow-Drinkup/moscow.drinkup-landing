---
import {SiteFooter, SiteHeader} from '@/shared/ui';

import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schemas?: unknown[];
}

const {title, description, ogImage, ogType, schemas} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  schemas={schemas}
>
  <slot name="head" slot="head" />
  <SiteHeader />
  <slot />
  <SiteFooter />
</BaseLayout>

<script>
  // Каркас страницы: цель для ссылки «К содержимому» и поведение лайтбокса.
  // Скрипты живут здесь, а не в блоках, чтобы разметку можно было рендерить
  // на этапе сборки и не отправлять в браузер React.
  const main = document.querySelector('main');
  if (main) {
    main.id = 'main';
    main.tabIndex = -1;
  }

  // Вкладки по рекомендациям ARIA Authoring Practices: стрелки, Home и End
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (index: number, moveFocus = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i]?.toggleAttribute('data-inactive', !selected);
      });

      if (moveFocus) {
        tabs[index]?.focus();
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));

      tab.addEventListener('keydown', (event) => {
        const lastIndex = tabs.length - 1;
        const moves: Record<string, number> = {
          ArrowRight: index === lastIndex ? 0 : index + 1,
          ArrowLeft: index === 0 ? lastIndex : index - 1,
          Home: 0,
          End: lastIndex,
        };

        const next = moves[event.key];
        if (next !== undefined) {
          event.preventDefault();
          select(next);
        }
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const counter = document.querySelector<HTMLElement>('[data-lightbox-counter]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));

  if (dialog && image && counter && triggers.length > 0) {
    const photos = triggers.map((trigger) => {
      const img = trigger.querySelector('img');
      return {src: img?.src ?? '', alt: img?.alt ?? ''};
    });

    let current = 0;

    const show = (index: number) => {
      current = (index + photos.length) % photos.length;
      image.src = photos[current].src;
      image.alt = photos[current].alt;
      counter.textContent = `${current + 1} / ${photos.length}`;
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        show(index);
        dialog.showModal();
      });
    });

    document
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    document
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));
    document
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());

    // Клик по подложке за пределами картинки закрывает просмотр
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        show(current + 1);
      }
    });
  }
</script>

<style is:global>
  /* PageConstructor рендерит собственный main — отступ под фиксированной шапкой
     задаём ему, а не своей обёртке */
  main {
    /* высота фиксированной шапки; вертикальный ритм ниже задают
       отступы блоков PageConstructor */
    padding-top: 61px;
  }

  main:focus {
    outline: none;
  }
</style>
