---
export interface TabItem {
  id: string;
  label: string;
}

interface Props {
  /** Идентификатор набора вкладок: нужен, если их на странице несколько. */
  name: string;
  items: TabItem[];
}

const {name, items} = Astro.props;
---

{/* Панели вкладок передаются слотами с именами, совпадающими с id вкладки */}
<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label="Разделы">
    {
      items.map((item, index) => (
        <button
          type="button"
          class="tabs__tab"
          role="tab"
          id={`${name}-tab-${item.id}`}
          aria-controls={`${name}-panel-${item.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {item.label}
        </button>
      ))
    }
  </div>

  {
    items.map((item, index) => (
      <div
        class="tabs__panel"
        role="tabpanel"
        id={`${name}-panel-${item.id}`}
        aria-labelledby={`${name}-tab-${item.id}`}
        tabindex="0"
        data-inactive={index === 0 ? undefined : ''}
      >
        <slot name={item.id} />
      </div>
    ))
  }
</div>

<script>
  // Вкладки по рекомендациям ARIA Authoring Practices: стрелки, Home и End.
  // До загрузки скрипта видна первая панель — остальные скрыты атрибутом,
  // так что содержимое остаётся в разметке и доступно поиску.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (index: number, moveFocus = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i]?.toggleAttribute('data-inactive', !selected);
      });

      if (moveFocus) {
        tabs[index]?.focus();
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));

      tab.addEventListener('keydown', (event) => {
        const lastIndex = tabs.length - 1;
        const moves: Record<string, number> = {
          ArrowRight: index === lastIndex ? 0 : index + 1,
          ArrowLeft: index === 0 ? lastIndex : index - 1,
          Home: 0,
          End: lastIndex,
        };

        const next = moves[event.key];
        if (next !== undefined) {
          event.preventDefault();
          select(next);
        }
      });
    });
  });
</script>

<style>
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .tabs__tab {
    padding: 12px 20px;
    background: none;
    border: 1px solid var(--g-color-line-generic);
    border-radius: 999px;
    color: var(--g-color-text-secondary);
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
  }

  .tabs__tab:hover {
    color: var(--g-color-text-primary);
    border-color: var(--g-color-line-brand);
  }

  .tabs__tab[aria-selected='true'] {
    background: rgb(240 144 24 / 14%);
    border-color: var(--g-color-line-brand);
    color: var(--g-color-text-brand);
  }

  .tabs__panel[data-inactive] {
    display: none;
  }

  .tabs__panel:focus-visible {
    outline: 2px solid var(--g-color-text-brand);
    outline-offset: 4px;
    border-radius: 8px;
  }
</style>
