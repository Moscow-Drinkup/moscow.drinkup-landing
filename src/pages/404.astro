---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import {SITE} from '@/shared/config';
---

<BaseLayout
  title={`Страница не найдена — ${SITE.name}`}
  description="Такой страницы нет. Вернитесь на главную или посмотрите ближайшие дринкапы."
>
  <main class="not-found">
    <h1 class="not-found__title">404</h1>
    <p class="not-found__text">
      Такой страницы нет — возможно, она переехала вместе с нами из старого формата ссылок.
    </p>
    <p class="not-found__links">
      <a href="/">На главную</a>
      <span aria-hidden="true">·</span>
      <a href="/events">Все мероприятия</a>
    </p>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 100vh;
    padding: 24px;
    text-align: center;
    color: var(--g-color-text-primary);
  }

  .not-found__title {
    margin: 0;
    font-family: var(--g-font-family-monospace);
    font-size: clamp(64px, 18vw, 140px);
    font-weight: 800;
    line-height: 1;
    color: var(--g-color-text-brand);
  }

  .not-found__text {
    max-width: 480px;
    margin: 0;
    color: var(--g-color-text-secondary);
  }

  .not-found__links {
    display: flex;
    gap: 12px;
    margin: 0;
  }

  .not-found__links a {
    color: var(--g-color-text-brand);
  }
</style>
