---
import {EventPage} from '@/_pages/event';
import {getEvents} from '@/shared/api';
import type {DrinkupEvent} from '@/shared/api';

// Страницы всех мероприятий генерируются на этапе сборки
export async function getStaticPaths() {
  const events = await getEvents();

  return events.map((event) => ({
    params: {id: String(event.id)},
    props: {event},
  }));
}

const {event} = Astro.props as {event: DrinkupEvent};
---

<EventPage event={event} />
