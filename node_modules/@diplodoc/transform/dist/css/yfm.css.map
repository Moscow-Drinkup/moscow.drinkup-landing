  height: 20px;
}

.wide-content-overlay {
  z-index: 100;
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background-color: var(--yfm-color-modal-wide-content-overlay, var(--yfm-color-modal-wide-content-overlay-private));
  opacity: 0.6;
}

details.yfm-cut > .yfm-cut-content {
