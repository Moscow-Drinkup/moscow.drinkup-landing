  --yfm-color-code-background-hovered-private: rgba(107, 132, 153, 0.2);
  --yfm-color-hljs-background-private: rgba(107, 132, 153, 0.12);
  --yfm-color-hljs-subst-private: #444;
  --yfm-color-hljs-comment-private: #888888;
