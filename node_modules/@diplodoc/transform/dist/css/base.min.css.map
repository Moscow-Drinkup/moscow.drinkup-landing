}
.yfm pre * code {
  display: inline;
  padding: 0;
  margin: 0;
  overflow: visible;
  word-wrap: normal;
  background-color: transparent;
  border: 0;
  color: var(--yfm-color-text, var(--yfm-color-text-private));
}
.yfm pre > code {
  display: block;
  padding: 16px;
  overflow: auto;
  background-color: var(--yfm-color-code-background, var(--yfm-color-code-background-private));
  color: var(--yfm-color-text, var(--yfm-color-text-private));
